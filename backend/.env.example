# ============================================================================
# Space Consultant – Meta Ads + DoubleTick Lead Automation Platform
# Backend Environment Configuration Template (.env.example)
# NEVER commit your real .env file or real API keys to GitHub.
# ============================================================================

# Application Settings
APP_NAME="Space Consultant Lead Automation Platform"
APP_ENV=production
DEBUG=false
SECRET_KEY=replace_with_64_char_secure_random_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin Seed User (Change immediately in production)
INITIAL_ADMIN_EMAIL=admin@spaceconsultant.in
INITIAL_ADMIN_PASSWORD=ChangeThisStrongPassword!2026
INITIAL_ADMIN_NAME="Space Consultant Admin"

# Neon PostgreSQL Database Connection (SSL required on Neon/Render)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-cool-darkness-123456.ap-southeast-1.aws.neon.tech/space_consultant?sslmode=require
DB_SSL_REQUIRE=true

# Allowed Frontend CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,https://space-consultant-automation.netlify.app

# Meta Marketing & Graph API Configuration
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_VERIFY_TOKEN=YOUR_CUSTOM_META_WEBHOOK_VERIFY_TOKEN
META_ACCESS_TOKEN=YOUR_META_PAGE_OR_SYSTEM_USER_ACCESS_TOKEN
META_GRAPH_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# DoubleTick WhatsApp Business API Configuration
DOUBLETICK_API_KEY=YOUR_DOUBLETICK_PUBLIC_API_KEY
DOUBLETICK_SENDER=+919810000000
DOUBLETICK_WEBHOOK_SECRET=YOUR_DOUBLETICK_WEBHOOK_BEARER_SECRET
DOUBLETICK_BASE_URL=https://public.doubletick.io

# WhatsApp Compliance & Follow-up Worker Configuration
WHATSAPP_REQUIRE_EXPLICIT_CONSENT=false
FOLLOWUP_WORKER_ENABLED=true
FOLLOWUP_POLL_INTERVAL_SECONDS=60
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Optional Gemini AI Auto-Reply Configuration
AI_REPLY_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Google Sheets Webhook Sync
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_WEBHOOK_URL=
